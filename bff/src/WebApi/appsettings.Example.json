{
  "Security": {
    "requireHttpsMetadata": true,
    "cors": {
      "allowAnyOrigin": false,
      "allowedOrigins": [
        "https://your-frontend-domain.com",
        "https://another-allowed-origin.com"
      ]
    }
  },
  "Keycloak": {
    "baseAddress": "https://your-keycloak-domain/",
    "realm": "project-follow-up",
    "clientId": "webapi-bff",
    "clientSecret": "SECRETS_STORAGE:Keycloak__clientSecret",
    "validIssuer": "https://your-keycloak-domain/realms/project-follow-up"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kurrent": {
    "ConnectionString": "SECRETS_STORAGE:Kurrent__ConnectionString",
    "AggregateNameMappings": {
      "ProjectFollowUp.BFF.Domain.User.UserAggregateRoot, ProjectFollowUp.BFF.Domain": "UserProfile",
      "ProjectFollowUp.BFF.Domain.Project.ProjectAggregateRoot, ProjectFollowUp.BFF.Domain": "Project",
      "ProjectFollowUp.BFF.Domain.ActivationLink.ActivationLinkAggregateRoot, ProjectFollowUp.BFF.Domain": "ActivationLink"
    },
    "ReadModelHydration": {
      "SubscriptionName": "read-model-hydrator-subscription",
      "CheckpointAfterMs": 200,
      "CheckpointLowerBound": 1,
      "CheckpointUpperBound": 10
    }
  },
  "MailSettings": {
    "host": "SECRETS_STORAGE:MailSettings__host",
    "port": "SECRETS_STORAGE:MailSettings__port",
    "username": "SECRETS_STORAGE:MailSettings__username",
    "password": "SECRETS_STORAGE:MailSettings__password"
  },
  "EventBus": {
    "connectionString": "SECRETS_STORAGE:EventBus__connectionString"
  },
  "QueueMappings": {
    "exchanges": [
      {
        "eventType": "ProjectFollowUp.BFF.Domain.User.DomainEvents.UserRegistered, ProjectFollowUp.BFF.Domain",
        "exchangeName": "EX.bff.user.registered"
      },
      {
        "eventType": "ProjectFollowUp.BFF.Domain.ActivationLink.DomainEvents.ActivationLinkGenerated, ProjectFollowUp.BFF.Domain",
        "exchangeName": "EX.bff.activation-link.generated"
      }
    ],
    "queues": [
      {
        "handlerType": "ProjectFollowUp.BFF.Infrastructure.EventBus.ActivationLinks.CreateActivationLinkConsumer, ProjectFollowUp.BFF.Infrastructure",
        "queueName": "QU.bff.activation-link.user.registered"
      },
      {
        "handlerType": "ProjectFollowUp.BFF.Infrastructure.EventBus.Documents.SendActivationMailConsumer, ProjectFollowUp.BFF.Infrastructure",
        "queueName": "QU.bff.documents.activation-link-generated"
      }
    ]
  },
  "Mongo": {
    "ConnectionString": "SECRETS_STORAGE:Mongo__ConnectionString",
    "DatabaseName": "ProjectFollowUp"
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "ServiceName": "ProjectFollowUp.BFF.WebApi",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint": "https://your-otlp-endpoint:4317",
    "Environment": "production"
  }
}
